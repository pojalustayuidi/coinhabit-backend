# Copy to .env; generate three separate random values. Never commit .env.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# At least 32 random ASCII bytes; same value in every service.
JWT_SECRET=
# Milliseconds: regular session 24h, guest session 7 days; accepted range 1min..7days.
JWT_EXPIRATION=86400000
JWT_GUEST_EXPIRATION=604800000
# Optional SMTP. docker compose --profile mail up --build uses Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
MAIL_FROM=noreply@coinhabit.local
VERIFICATION_URL=http://localhost:8080/api/auth/verify-email
